#!/bin/sh

# This bash script is just for testing the development
# ../lib/convertgls2bib.jar
# file. The file convertgls2bib.tlu will be the script that's distributed.
#
# The file texjavaparserlib.jar 
# needs to be placed in the same directory as convertgls2bib.jar
# for this to work.

bindir=`dirname "$0"`
java -jar "$bindir/../lib/convertgls2bib.jar" "$@"
